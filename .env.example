# Copy these names into Vercel -> Project -> Settings -> Environment Variables.
# NEVER commit real values. Real secrets live only in Vercel.

# --- Required ---
APP_PASSWORD=choose-a-long-random-passphrase-min-8-chars
GEMINI_API_KEY=
GROQ_API_KEY=
GITHUB_TOKEN=
GITHUB_REPO=your-username/hybrid-ai-agent
VERCEL_TOKEN=
VERCEL_TEAM_ID=

# --- Optional ---
GITHUB_BRANCH=main
OPENROUTER_API_KEY=
TAVILY_API_KEY=
VERCEL_DEPLOY_HOOK_URL=
# Fixed public address for OAuth redirects (defaults to the production domain)
APP_URL=
# Model chains are built into lib/agents.ts (Gemini 4 Hydrogen first for specialists, Groq first for the
# lead orchestrator). These optional variables only change the FIRST model of a chain.
AGENT_PRIMARY_GEMINI=
AGENT_PRIMARY_GROQ=
OPENROUTER_MODEL=openai/gpt-oss-120b:free

# --- Image generation for the Image Studio agent (all free, all optional) ---
# Tried in order: Cloudflare FLUX.1 schnell -> Cloudflare SDXL Lightning -> Hugging Face FLUX -> Hugging Face SDXL -> Pollinations (no key)
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
HF_TOKEN=
POLLINATIONS_TOKEN=

# --- Google Drive storage (optional but recommended) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GOOGLE_DRIVE_FOLDER_NAME=Hybrid AI Agent - App Data

# --- Automation connectors (optional) ---
MAKE_WEBHOOK_URL=
N8N_WEBHOOK_URL=
