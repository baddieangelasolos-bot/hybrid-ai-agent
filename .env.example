# Copy these names into Vercel -> Project -> Settings -> Environment Variables.
# NEVER commit real values. Real secrets live only in Vercel.

# --- Required ---
APP_PASSWORD=choose-a-long-random-passphrase-min-8-chars
GROQ_API_KEY=
GEMINI_API_KEY=
GITHUB_TOKEN=
GITHUB_REPO=your-username/hybrid-ai-agent
VERCEL_TOKEN=
VERCEL_TEAM_ID=

# --- Optional ---
GITHUB_BRANCH=main
OPENROUTER_API_KEY=
TAVILY_API_KEY=
VERCEL_DEPLOY_HOOK_URL=
GROQ_MODEL=openai/gpt-oss-120b
GEMINI_MODEL=gemini-flash-latest
OPENROUTER_MODEL=openai/gpt-oss-120b:free

# --- Google Drive storage (optional but recommended) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GOOGLE_DRIVE_FOLDER_NAME=Hybrid AI Agent - App Data

# --- Automation connectors (optional) ---
MAKE_WEBHOOK_URL=
N8N_WEBHOOK_URL=
